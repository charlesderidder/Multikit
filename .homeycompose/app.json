{
  "id": "dev.charlesderidder.multikit",
  "version": "1.0.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Multikit",
    "de": "Multikit",
    "nl": "Multikit"
  },
  "description": {
    "en": "Bring your automations together with a versatile set of local tools",
    "de": "Automatisierungen mit vielseitigen lokalen Werkzeugen verbinden",
    "nl": "Breng je automatiseringen samen met veelzijdige lokale hulpmiddelen"
  },
  "category": [
    "internet"
  ],
  "permissions": [],
  "api": {
    "getBrowserUsername": {
      "method": "GET",
      "path": "/browser-username"
    },
    "setBrowserPassword": {
      "method": "POST",
      "path": "/browser-password"
    },
    "testEmail": {
      "method": "POST",
      "path": "/test-email"
    },
    "syncCalendars": {
      "method": "POST",
      "path": "/sync-calendars"
    },
    "setCountdownRemaining": {
      "method": "POST",
      "path": "/countdown-remaining"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Charles de Ridder",
    "email": "charlesderidder@gmail.com"
  },
  "brandColor": "#0052cc",
  "contributors": {
    "developers": [
